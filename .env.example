# Copy this file to .env and fill in your values.  (.env is git-ignored.)

# Your Anthropic API key from https://console.anthropic.com
# Leave empty to run in demo mode (the site works, replies are a built-in demo).
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# DEFAULT_MODEL=claude-opus-5-5        # claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
# DEFAULT_EFFORT=medium                # low | medium | high
# MAX_TOKENS=64000                     # max tokens per reply (thinking + answer)
# RATE_LIMIT_PER_MINUTE=20             # chat requests per IP per minute (0 = unlimited)
# ACCESS_CODE=                         # set to require a code before anyone can chat
# TRUST_PROXY=false                    # true when running behind a reverse proxy (Render, Railway...)
# APP_NAME=NovaChat
